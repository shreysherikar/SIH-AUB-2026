# Copy this file to .env.local and fill in your Supabase project values.
# Find these in Supabase dashboard -> Project Settings -> API
# NEXT_PUBLIC_ vars are safe to expose in the browser -- Supabase's
# Row Level Security policies (see supabase/schema.sql) are what actually
# keep data safe, not secrecy of this key.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Used only to show your event name/date across the site without editing code
NEXT_PUBLIC_EVENT_NAME="Smart India Hackathon - Internal Round"
NEXT_PUBLIC_EVENT_DATE=2026-09-15T09:00:00+05:30

# --- Server-only secrets below. NEVER prefix these with NEXT_PUBLIC_ ---
# They must stay out of the browser bundle.

# Supabase dashboard -> Project Settings -> API -> "service_role" key.
# Used only inside pages/api/register.js to save registrations and check the
# open/closed setting. Keep this secret -- it bypasses Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend (resend.com) is used to send the registration confirmation email.
# Free tier is generous for a college event. Sign up, verify a sending
# domain (or use their onboarding@resend.dev sandbox address while testing),
# then create an API key.
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL="Amity SIH Portal <onboarding@resend.dev>"

# Cloudflare Turnstile (free, no card required) -- real spam/bot protection
# for the registration and queries forms, replacing the old math-sum check.
# Get these from dash.cloudflare.com -> Turnstile -> Add site.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=your-turnstile-site-key
TURNSTILE_SECRET_KEY=your-turnstile-secret-key
